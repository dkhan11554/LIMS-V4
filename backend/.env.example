ENVIRONMENT=development

# Postgres (default):
DATABASE_URL=postgresql+psycopg://lims:lims@localhost:5432/lims
# SQL Server (requires the `mssql` extra + ODBC Driver 18 for SQL Server installed on the host):
# DATABASE_URL=mssql+pyodbc://lims:lims@localhost:1433/lims?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

DATABASE_ECHO=false

JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=20160

CORS_ORIGINS=http://localhost:5173

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# MinIO (only if STORAGE_BACKEND=minio):
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=lims-documents
# MINIO_SECURE=false

# Optional, only needed if the AI Copilot / AI Intelligence modules are ported (see MIGRATION.md):
# OPENAI_API_KEY=
